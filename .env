# Valores padrão (sem segredos). Sobrescreva em .env.local.
# Ativa o backend simulado (MSW REST + Socket.IO). A demonstração publicada usa mocks.
VITE_ENABLE_MOCKS=true
# Base da API REST consumida pelo Axios.
VITE_API_URL=/api
# Endpoint do Socket.IO. Em modo mock é interceptado pelo MSW (nenhuma conexão real é aberta).
VITE_SOCKET_URL=wss://realtime.kurio.mock
# Exibe o Chaos Lab (painel de cenários) quando os mocks estão ativos.
VITE_ENABLE_CHAOS_LAB=true
